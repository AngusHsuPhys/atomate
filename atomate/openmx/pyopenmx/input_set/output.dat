#
#      File Name      
#

System.CurrrentDirectory         ./    # default=./
System.Name                      c60
level.of.stdout                   1 # default=1 (0-2)
level.of.fileout                  1 # default=1 (0-2)

#
# Definition of Atomic Species
#

Species.Number       1
<Definition.of.Atomic.Species
C   C5.0-s2p2   C_PBE19

Definition.of.Atomic.Species>

